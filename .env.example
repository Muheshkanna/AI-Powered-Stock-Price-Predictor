# PostgreSQL Connection String (Pooled connection for runtime API server)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require

# Direct / Unpooled Connection String (Used for Prisma migrations)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET= 1de1ba114fbd57d9d20ce7cb0c35c43516041d35634b807e2b489a6807acfe33474fa72f71a229796936e1590382b250

# Connection pool settings (optional, defaults to 10)
PG_POOL_MAX=10

# Optional SSL toggle ('true' or append ?sslmode=require to DATABASE_URL)
PG_SSL=false
