{
  "name": "backend",
  "version": "1.0.0",
  "description": "Insight AI Finance Backend API - PostgreSQL Edition",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node test/db.test.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "seed:user": "node seedUser.js",
    "seed:transactions": "node seedTransactions.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:mongo": "node scripts/migrate-mongo-to-postgres.js"
  },
