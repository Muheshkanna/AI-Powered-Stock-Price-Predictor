# PostgreSQL Connection String (Standard PostgreSQL, Neon, Supabase, Railway, Render, or Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_finance_app?schema=public

# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET=your_secure_jwt_secret_here

# Connection pool settings (optional, defaults to 10)
PG_POOL_MAX=10

# Optional SSL toggle ('true' or append ?sslmode=require to DATABASE_URL)
PG_SSL=false

