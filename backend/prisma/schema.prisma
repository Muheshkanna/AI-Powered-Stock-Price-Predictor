datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  password     String        @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  transactions Transaction[]

  @@map("users")
}

model Stock {
  id             String   @id @default(uuid()) @db.Uuid
  symbol         String   @unique @db.VarChar(20)
  name           String   @db.VarChar(255)
  price          Decimal  @db.Decimal(18, 4)
  change         Decimal  @db.Decimal(18, 4)
  changePercent  Decimal  @map("change_percent") @db.Decimal(10, 4)
  volume         String   @db.VarChar(50)
  marketCap      String   @map("market_cap") @db.VarChar(50)
  aiPrediction   Json     @map("ai_prediction")
  historicalData Json     @map("historical_data")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([changePercent])
  @@map("stocks")
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  symbol    String   @db.VarChar(20)
  type      String   @db.VarChar(10)
  quantity  Decimal  @db.Decimal(18, 4)
  price     Decimal  @db.Decimal(18, 4)
  timestamp DateTime @default(now()) @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([symbol])
  @@map("transactions")
}
